#!/bin/bash
# Unified Boot & Snapshot Management
set -euo pipefail

HOSTNAME="{{ .chezmoi.hostname }}"
echo "🚀 Starting Boot/Snapshot Config for $HOSTNAME..."

# --- 1. AUR Helper & Packages ---
AUR_HELPER=$(command -v paru || command -v yay)
$AUR_HELPER -S --needed --noconfirm limine-snapper-sync snap-pac limine-mkinitcpio-hook

# --- 2. Limine/Snapper Defaults ---
DEFAULT_CONF="/etc/default/limine"
MASTER_CONF="/boot/limine.conf"

sudo touch "$DEFAULT_CONF"
for var in "LIMINE_CONFIG=\"$MASTER_CONF\"" "ROOT_SNAPSHOTS_PATH=\"/@snapshots\"" "MAX_SNAPSHOT_ENTRIES=30"; do
    key=$(echo $var | cut -d= -f1)
    sudo sed -i "/^$key=/d" "$DEFAULT_CONF"
    echo "$var" | sudo tee -a "$DEFAULT_CONF" > /dev/null
done

{{ if eq .chezmoi.hostname "arch-surface" -}}
# Hardware-specific boot args
BASE_ARGS="root=PARTUUID=b5133817-b3a7-47c7-8400-48ef72672a80 zswap.enabled=0 rootflags=subvol=@ rw rootfstype=btrfs"
sudo sed -i '/^KERNEL_CMDLINE/d' "$DEFAULT_CONF"
echo "KERNEL_CMDLINE[default]=\"$BASE_ARGS pci=hpiosize=0 pcie_aspm=off intel_iommu=on,igfx_off usb4_port_reset\"" | sudo tee -a "$DEFAULT_CONF" >/dev/null
echo "DEFAULT_ENTRY=3" | sudo tee -a "$DEFAULT_CONF" >/dev/null
{{ end -}}

# --- 3. Regeneration ---
sudo limine-mkinitcpio 

{{ if eq .chezmoi.hostname "arch-surface" -}}
sudo sed -i 's/^default_entry: .*/default_entry: 3/' "$MASTER_CONF"
{{ end -}}

# FAT32 Mirroring
for dest in "/boot/EFI/arch-limine/limine.conf" "/boot/EFI/limine/limine.conf"; do
    sudo mkdir -p "$(dirname "$dest")"
    sudo cp "$MASTER_CONF" "$dest"
done

sudo systemctl enable --now limine-snapper-sync.service
sudo limine-snapper-sync

echo "🎉 Boot/Snapshot Initialization complete!"