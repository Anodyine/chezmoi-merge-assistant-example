#!/bin/bash
# Unified Boot & Snapshot Management - Source-First & Host-Aware Version
set -euo pipefail

HOSTNAME="{{ .chezmoi.hostname }}"
echo "🚀 Starting Boot/Snapshot Config for $HOSTNAME..."

# --- 1. AUR Helper & Packages ---
AUR_HELPER=$(command -v paru || command -v yay)
$AUR_HELPER -S --needed --noconfirm limine-snapper-sync snap-pac limine-mkinitcpio-hook

# --- 2. Limine/Snapper Defaults (The SOURCE of truth) ---
DEFAULT_CONF="/etc/default/limine"
MASTER_CONF="/boot/limine.conf"

sudo touch "$DEFAULT_CONF"

# Standard variables for all hosts
VARS=(
    "LIMINE_CONFIG=\"$MASTER_CONF\""
    "ROOT_SNAPSHOTS_PATH=\"/@snapshots\""
    "MAX_SNAPSHOT_ENTRIES=30"
)

for var in "${VARS[@]}"; do
    key=$(echo $var | cut -d= -f1)
    sudo sed -i "/^$key=/d" "$DEFAULT_CONF"
    echo "$var" | sudo tee -a "$DEFAULT_CONF" > /dev/null
done

{{ if eq .chezmoi.hostname "arch-surface" -}}
# --- 3. Surface-Specific Configuration ---

# A. USB Crash & Graphics Stability
# These force text mode and skip the countdown window to prevent the 5s crash
SURFACE_VARS=(
    "TERMINAL_MODE=text"
    "GRAPHICS=no"
    "TIMEOUT=0"
    "DEFAULT_ENTRY=3"
)

for var in "${SURFACE_VARS[@]}"; do
    key=$(echo $var | cut -d= -f1)
    sudo sed -i "/^$key=/d" "$DEFAULT_CONF"
    echo "$var" | sudo tee -a "$DEFAULT_CONF" > /dev/null
done

# B. Kernel Boot Arguments
BASE_ARGS="root=PARTUUID=b5133817-b3a7-47c7-8400-48ef72672a80 zswap.enabled=0 rootflags=subvol=@ rw rootfstype=btrfs"
sudo sed -i '/^KERNEL_CMDLINE/d' "$DEFAULT_CONF"
echo "KERNEL_CMDLINE[default]=\"$BASE_ARGS pci=hpiosize=0 pcie_aspm=off intel_iommu=on,igfx_off usb4_port_reset\"" | sudo tee -a "$DEFAULT_CONF" >/dev/null

{{ else -}}
# --- 4. Standard Host Configuration (e.g., ml-server) ---
# Ensure normal hosts have a visible menu and graphical support if desired
sudo sed -i "/^TIMEOUT=/d" "$DEFAULT_CONF"
echo "TIMEOUT=5" | sudo tee -a "$DEFAULT_CONF" > /dev/null
{{ end -}}

# --- 5. Regeneration (The GENERATOR) ---
# This command reads /etc/default/limine and WRITES the generated file.
echo "⚙️  Regenerating bootloader configuration from source..."
sudo limine-mkinitcpio 

# --- 6. Activation ---
sudo systemctl daemon-reload
sudo systemctl enable --now limine-snapper-sync.service
sudo limine-snapper-sync

echo "🎉 Boot initialization complete for $HOSTNAME."